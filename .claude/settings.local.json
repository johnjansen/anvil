{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/enforce-no-stash.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh issue create:*)",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go vet:*)",
      "Bash(make build:*)",
      "Bash(/tmp/anvil add:*)",
      "Bash(/tmp/anvil watch:*)"
    ]
  }
}
